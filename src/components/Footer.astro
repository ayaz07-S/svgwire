---
const year = new Date().getFullYear();
---

<footer
  class="border-t border-hairline bg-canvas px-6 py-16 transition-colors duration-200"
>
  <div class="mx-auto grid max-w-[1400px] gap-12 md:grid-cols-4">
    <!-- Brand -->
    <div class="md:col-span-1">
      <div class="mb-3 flex items-center h-[26px]">
        <img src="/brand/svgwire-wordmark-light.svg" alt="SVGWire" class="h-full w-auto dark:hidden" />
        <img src="/brand/svgwire-wordmark-dark.svg" alt="" aria-hidden="true" class="hidden h-full w-auto dark:block" />
      </div>
      <p class="text-body-sm text-mute">
        Client-side SVG to component converter. Your files never leave your browser.
      </p>
    </div>

    <!-- Converters -->
    <div>
      <h3 class="text-caption-mono text-mute uppercase tracking-wider mb-4">
        Converters
      </h3>
      <ul class="space-y-2.5">
        <li>
          <a
            href="/svg-to-react"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >SVG to React</a>
        </li>
        <li>
          <a
            href="/svg-to-vue"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >SVG to Vue 3</a>
        </li>
        <li>
          <a
            href="/svg-to-svelte"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >SVG to Svelte 5</a>
        </li>
        <li>
          <a
            href="/svg-to-react-native"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >SVG to React Native</a>
        </li>
        <li>
          <a
            href="/svg-to-tailwind-react"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >SVG to Tailwind React</a>
        </li>
        <li>
          <a
            href="/batch"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Batch Folder Converter</a>
        </li>
        <li>
          <a
            href="/sprite"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >SVG Sprite Generator</a>
        </li>
      </ul>
    </div>

    <!-- Resources -->
    <div>
      <h3 class="text-caption-mono text-mute uppercase tracking-wider mb-4">
        Resources
      </h3>
      <ul class="space-y-2.5">
        <li>
          <a
            href="https://github.com/ayaz07-S/svgwire.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >GitHub</a>
        </li>
        <li>
          <a
            href="https://developer.mozilla.org/en-US/docs/Web/SVG"
            target="_blank"
            rel="noopener noreferrer"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >SVG Reference (MDN)</a>
        </li>
      </ul>
    </div>

    <!-- Built With -->
    <div>
      <h3 class="text-caption-mono text-mute uppercase tracking-wider mb-4">
        Built With
      </h3>
      <ul class="space-y-2.5">
        <li>
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Astro</a>
        </li>
        <li>
          <a
            href="https://react.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >React Islands</a>
        </li>
        <li>
          <a
            href="https://tailwindcss.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Tailwind CSS v4</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom -->
  <div
    class="mx-auto mt-12 max-w-[1400px] border-t border-hairline pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
  >
    <p class="text-caption text-mute">
      © {year} SVGWire. All processing happens in your browser. · No data is ever sent to a server.
    </p>
    <div class="flex flex-wrap gap-x-4 gap-y-2">
      <a href="/faq" class="text-caption text-mute hover:text-ink transition-colors">FAQ</a>
      <a href="/privacy" class="text-caption text-mute hover:text-ink transition-colors">Privacy Policy</a>
      <a href="/terms" class="text-caption text-mute hover:text-ink transition-colors">Terms of Service</a>
    </div>
  </div>
</footer>
