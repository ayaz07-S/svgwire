---
interface Props {
  framework: string;
}

const { framework } = Astro.props;

const seoBlocks: Record<string, { title: string; content: string }[]> = {
  react: [
    {
      title: 'Why convert SVG to React components?',
      content: 'Inline SVG in JSX gives you full CSS and JavaScript control over every path, fill, and stroke. Unlike <img> tags, React SVG components support dynamic props, theme-aware colors via currentColor, and tree-shaking — meaning unused icons never ship to your users. SVGWire handles the tedious attribute mapping (stroke-width → strokeWidth, fill-rule → fillRule) automatically.',
    },
    {
      title: 'TypeScript support built in.',
      content: 'Every generated component includes full TypeScript types. Props extend React.SVGProps<SVGSVGElement>, giving you autocomplete for every SVG attribute in VS Code. Toggle TypeScript off to get clean JSX output for JavaScript projects.',
    },
    {
      title: 'Zero latency. Zero backend.',
      content: 'SVGWire runs entirely in your browser using DOMParser — no files are uploaded, no API calls are made, and no data leaves your machine. Paste your SVG and get your component in under 1ms.',
    },
  ],
  vue: [
    {
      title: 'Vue 3 SFC output with script setup.',
      content: 'SVGWire generates Vue 3 Single File Components using the modern <script setup> syntax. Each component includes defineOptions for component naming, v-bind="$attrs" for prop forwarding, and optional TypeScript support with defineProps<Props>().',
    },
    {
      title: 'Keeps SVG attributes in kebab-case.',
      content: 'Unlike React which requires camelCase, Vue templates use standard HTML attribute conventions. SVGWire preserves the native kebab-case format (stroke-width, fill-rule) so your Vue components look natural and idiomatic.',
    },
    {
      title: 'Tailwind CSS compatible.',
      content: 'Enable currentColor mode to replace hardcoded fill and stroke colors with currentColor. This lets you control icon colors with Tailwind\'s text-* utilities (text-blue-500, text-gray-900) — no style prop overrides needed.',
    },
  ],
  svelte: [
    {
      title: 'Svelte 5 runes syntax.',
      content: 'SVGWire generates Svelte 5 components using the new $props() runes syntax. Rest props are spread with {...restProps}, and class is properly destructured from $props() for seamless Tailwind/CSS integration.',
    },
    {
      title: 'Minimal bundle, maximum performance.',
      content: 'Svelte compiles components away at build time — there\'s no virtual DOM overhead. Your SVG icons become zero-runtime components that ship as vanilla DOM operations. Combined with SVGWire\'s client-side processing, your icon workflow has zero waste.',
    },
    {
      title: 'Works with SvelteKit.',
      content: 'Generated components drop directly into your $lib/icons/ directory. Import them anywhere in your SvelteKit app with full TypeScript support and automatic prop type inference.',
    },
  ],
  'react-native': [
    {
      title: 'React Native SVG with proper imports.',
      content: 'SVGWire maps standard SVG elements to their react-native-svg equivalents: <path> becomes <Path>, <circle> becomes <Circle>, <g> becomes <G>. Import statements are automatically generated based on which elements your SVG uses.',
    },
    {
      title: 'NativeWind support.',
      content: 'Enable the NativeWind toggle to wrap your component with styled() from nativewind. This lets you apply Tailwind CSS utility classes to your SVG icons in React Native — className="text-blue-500 w-6 h-6" just works.',
    },
    {
      title: 'Size and color props.',
      content: 'Every generated React Native component accepts size (number) and color (string) props with sensible defaults. The size prop maps to both width and height simultaneously, and color flows through to fill/stroke via currentColor.',
    },
  ],
  'tailwind-react': [
    {
      title: 'Built for Tailwind CSS projects.',
      content: 'This converter pre-applies the three most common Tailwind optimizations: removes hardcoded width/height (use w-6 h-6 instead), replaces all colors with currentColor (use text-blue-500 instead), and adds a className prop for utility class composition.',
    },
    {
      title: 'One-click icon system.',
      content: 'The Tailwind React preset gives you icons that work like Heroicons or Lucide out of the box. Drop your custom SVGs through the converter and get components that follow the same API: <MyIcon className="w-5 h-5 text-gray-500" />.',
    },
    {
      title: 'Design system ready.',
      content: 'Generated components extend React.SVGProps, letting you spread any SVG attribute. Combined with currentColor and className forwarding, these icons integrate seamlessly into design systems built with Tailwind CSS.',
    },
  ],
  batch: [
    {
      title: 'Parallel folder conversion.',
      content: 'Drop an entire folder of SVGs into the browser. SVGWire recursively scans directories and converts files in parallel, preserving your exact folder structure in the output.',
    },
    {
      title: 'Zero-backend local ZIP bundling.',
      content: 'Batch processing happens entirely in your local browser using DOMParser and JSZip. No server round-trips, no file uploads, and complete privacy. Download a bundled .zip instantly.',
    },
    {
      title: 'Cross-framework support.',
      content: 'Convert folders to React, Vue 3, Svelte 5, or React Native components in one go. Each file gets the exact same optimization, formatting, and TypeScript support as our single-file converter.',
    }
  ],
  sprite: [
    {
      title: 'Compile SVG symbols.',
      content: 'Combine multiple SVGs into a single <symbol> based sprite.svg sheet. This eliminates HTTP asset waterfalls and allows you to cache all your icons in a single network request.',
    },
    {
      title: 'Type-safe TypeScript unions.',
      content: 'SVGWire automatically generates an icon-names.ts file containing a TypeScript union type of all your compiled sprite IDs. Get flawless autocomplete for your icon names in your IDE.',
    },
    {
      title: 'Preserves design systems.',
      content: 'Our sprite compiler preserves root presentation attributes (like fill and stroke) on the <symbol> while stripping unnecessary wrappers, ensuring your sprite sheet integrates perfectly with Tailwind CSS and currentColor.',
    }
  ]
};

const pageFaqs: Record<string, { question: string; answer: string }[]> = {
  react: [
    {
      question: 'What is SVGWire and how does it convert SVG to React?',
      answer: 'SVGWire converts raw SVG assets into production-ready React JSX/TSX components locally in your browser. It maps SVG attributes to camelCase (e.g. stroke-width → strokeWidth) and supports forwardRef, TypeScript interfaces, and currentColor.',
    },
    {
      question: 'Are my SVG files uploaded to a server?',
      answer: 'Your SVGs are processed locally in your browser. Files are never uploaded to a server.',
    },
    {
      question: 'What is the TypeScript output for React?',
      answer: 'When TypeScript is enabled, generated React components extend React.SVGProps<SVGSVGElement>, giving you complete autocomplete for all SVG attributes in VS Code.',
    },
    {
      question: 'What does the currentColor option do?',
      answer: 'It replaces fixed fill/stroke color values with "currentColor", allowing you to control icon colors using Tailwind text-* utility classes or parent CSS.',
    },
  ],
  vue: [
    {
      question: 'Does SVGWire support Vue 3 Single File Components?',
      answer: 'Yes! SVGWire outputs Vue 3 SFCs using modern <script setup> syntax with optional TypeScript defineProps<Props>() and v-bind="$attrs".',
    },
    {
      question: 'Are my SVG files uploaded to a server?',
      answer: 'Your SVGs are processed locally in your browser. Files are never uploaded to a server.',
    },
    {
      question: 'Why does Vue keep SVG attributes in kebab-case?',
      answer: 'Unlike React, Vue templates use standard HTML attribute conventions. SVGWire preserves native kebab-case attributes (stroke-width, fill-rule) for clean, idiomatic Vue components.',
    },
    {
      question: 'Can I use Tailwind CSS with Vue SVG components?',
      answer: 'Yes. Enable currentColor mode to control fill and stroke colors using Tailwind text-* classes (e.g., text-blue-500).',
    },
  ],
  svelte: [
    {
      question: 'Does SVGWire support Svelte 5 runes syntax?',
      answer: 'Yes. SVGWire generates Svelte 5 components using the new $props() runes syntax, spreading rest props with {...restProps}.',
    },
    {
      question: 'Are my SVG files uploaded to a server?',
      answer: 'Your SVGs are processed locally in your browser. Files are never uploaded to a server.',
    },
    {
      question: 'How do I use generated Svelte components in SvelteKit?',
      answer: 'Drop generated files into your $lib/icons/ directory and import them anywhere in your app with full TypeScript support.',
    },
    {
      question: 'What does Remove dimensions do in Svelte components?',
      answer: 'It removes fixed width and height attributes so your SVG icon can scale dynamically based on CSS container styles.',
    },
  ],
  'react-native': [
    {
      question: 'How does SVGWire convert SVGs for React Native?',
      answer: 'SVGWire maps standard SVG elements to react-native-svg primitives (<path> → <Path>, <circle> → <Circle>, <g> → <G>) and generates the necessary import statements.',
    },
    {
      question: 'What is the NativeWind option for React Native?',
      answer: 'When NativeWind is enabled, the component is wrapped with styled() from nativewind, letting you apply Tailwind utility classes directly via className.',
    },
    {
      question: 'Are my SVG files uploaded to a server?',
      answer: 'Your SVGs are processed locally in your browser. Files are never uploaded to a server.',
    },
    {
      question: 'What props do generated React Native components accept?',
      answer: 'Components accept size (number) and color (string) props with sensible defaults, making icon sizing and coloring effortless.',
    },
  ],
  'tailwind-react': [
    {
      question: 'What is the Tailwind React converter preset?',
      answer: 'It pre-applies the three most common Tailwind optimizations: removes fixed dimensions, sets currentColor, and adds a className prop.',
    },
    {
      question: 'Are my SVG files uploaded to a server?',
      answer: 'Your SVGs are processed locally in your browser. Files are never uploaded to a server.',
    },
    {
      question: 'What is Tailwind Mask output?',
      answer: 'Tailwind Mask mode encodes your SVG into an inline CSS mask URI (mask-image: url(...)), allowing you to style icons using background utilities.',
    },
    {
      question: 'Can I use generated Tailwind React components in design systems?',
      answer: 'Yes. Components extend React.SVGProps and accept className props, making them drop-in compatible with design systems.',
    },
  ],
  batch: [
    {
      question: 'Can I convert multiple SVG files at once?',
      answer: 'Yes. Drop or select an entire folder of SVGs. SVGWire processes all files in parallel inside your browser and packages them into a downloadable ZIP archive.',
    },
    {
      question: 'Does Batch Folder preserve nested folder structure?',
      answer: 'Yes. SVGWire recursively scans uploaded directories and preserves your exact folder layout inside the output ZIP.',
    },
    {
      question: 'Are SVG files uploaded to a server during batch conversion?',
      answer: 'Your SVGs are processed locally in your browser. Files are never uploaded to a server.',
    },
    {
      question: 'Which frameworks are supported in batch mode?',
      answer: 'You can convert folders to React, Vue 3, Svelte 5, or React Native components in a single batch pass.',
    },
  ],
  sprite: [
    {
      question: 'What is an SVG sprite sheet?',
      answer: 'An SVG sprite sheet combines multiple vector icons into a single <svg> file containing <symbol> nodes, reducing HTTP network requests to a single cached asset.',
    },
    {
      question: 'What files does Sprite mode generate?',
      answer: 'Sprite mode generates a compiled sprite.svg file and an icon-names.ts file with TypeScript union types of all icon IDs.',
    },
    {
      question: 'Are SVG files uploaded to a server during sprite generation?',
      answer: 'Your SVGs are processed locally in your browser. Files are never uploaded to a server.',
    },
    {
      question: 'How do I reference icons from the generated sprite?',
      answer: 'Use standard SVG symbol referencing: <svg><use href="/sprite.svg#icon-id" /></svg>.',
    },
  ],
};

const blocks = seoBlocks[framework] ?? seoBlocks.react;
const faqs = pageFaqs[framework] ?? pageFaqs.react;
---

<section class="border-t border-hairline bg-canvas" id="seo-content">
  <div class="mx-auto max-w-[1400px] px-6 py-20">
    <div class="grid gap-16 md:grid-cols-3">
      {blocks.map((block) => (
        <div>
          <h2 class="text-display-sm text-ink mb-3">{block.title}</h2>
          <p class="text-body-md text-body leading-relaxed">{block.content}</p>
        </div>
      ))}
    </div>

    {/* Related Converters */}
    {['react', 'vue', 'svelte', 'react-native', 'tailwind-react'].includes(framework) && (
      <div class="mt-16 pt-8 border-t border-hairline">
        <h3 class="text-body-md-strong text-ink mb-4">Related Converters</h3>
        <div class="flex flex-wrap gap-4">
          {framework !== 'react' && <a href="/svg-to-react" class="text-body-sm text-link hover:text-link-deep transition-colors">SVG to React</a>}
          {framework !== 'vue' && <a href="/svg-to-vue" class="text-body-sm text-link hover:text-link-deep transition-colors">SVG to Vue 3</a>}
          {framework !== 'svelte' && <a href="/svg-to-svelte" class="text-body-sm text-link hover:text-link-deep transition-colors">SVG to Svelte 5</a>}
          {framework !== 'react-native' && <a href="/svg-to-react-native" class="text-body-sm text-link hover:text-link-deep transition-colors">SVG to React Native</a>}
          {framework !== 'tailwind-react' && <a href="/svg-to-tailwind-react" class="text-body-sm text-link hover:text-link-deep transition-colors">SVG to Tailwind React</a>}
        </div>
      </div>
    )}

    {/* Page-relevant FAQs */}
    <div class="mt-16 pt-12 border-t border-hairline">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-display-sm text-ink font-semibold">Frequently Asked Questions</h2>
          <p class="text-body-sm text-mute mt-1">Quick answers for this tool.</p>
        </div>
        <a
          href="/faq"
          class="inline-flex items-center gap-1.5 text-body-sm font-medium text-ink hover:text-mute transition-colors shrink-0"
        >
          View all 18 FAQs
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="space-y-3 max-w-4xl">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-hairline bg-canvas-soft p-4 transition-colors duration-150 hover:border-hairline-strong">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-ink text-body-md select-none list-none [&::-webkit-details-marker]:hidden">
              <span class="text-body-md-strong text-ink">{faq.question}</span>
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-hairline text-mute group-open:rotate-180 transition-transform duration-200">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </span>
            </summary>
            <div class="mt-3 pt-3 border-t border-hairline/60 text-body-sm text-body leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
