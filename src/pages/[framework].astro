---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Converter } from '../components/converter/Converter';
import SeoContent from '../components/SeoContent.astro';
import { FRAMEWORKS, getFrameworkBySlug } from '../lib/frameworks';

export function getStaticPaths() {
  return FRAMEWORKS.map(fw => ({
    params: { framework: fw.slug },
    props: { frameworkId: fw.id },
  }));
}

interface Props {
  frameworkId: string;
}

const { frameworkId } = Astro.props;
const fw = getFrameworkBySlug(Astro.params.framework!);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': 'https://svgwire.com/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': fw.name,
      'item': `https://svgwire.com/${fw.slug}`,
    },
  ],
};
---

<BaseLayout title={fw.title} description={fw.description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Converter client:load defaultFramework={frameworkId} activeMode="single" />
  <SeoContent framework={frameworkId} />
</BaseLayout>
