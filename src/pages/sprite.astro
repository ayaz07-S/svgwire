---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Converter } from '../components/converter/Converter';
import SeoContent from '../components/SeoContent.astro';
---

<BaseLayout
  title="SVG Sprite Sheet Generator — Compile Symbols & Type-Safe TypeScript Unions | SVGWire"
  description="Combine multiple SVGs into a single sprite.svg sheet and generate type-safe TypeScript unions. Eliminate HTTP asset waterfalls and improve performance."
>
  <Converter client:load defaultFramework="react" activeMode="sprite" />
  <SeoContent framework="sprite" />
</BaseLayout>
