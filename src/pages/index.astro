---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Converter } from '../components/converter/Converter';
import SeoContent from '../components/SeoContent.astro';
---

<BaseLayout
  title="SVG2Component — Convert SVG to React, Vue, Svelte & React Native Components"
  description="Free, zero-latency SVG to component converter. Paste your SVG and get production-ready React, Vue 3, Svelte 5, and React Native components instantly — all processed in your browser."
>
  <Converter client:load defaultFramework="react" />
  <SeoContent framework="react" />

  <!-- Homepage-specific SEO content -->
  <section class="border-t border-hairline bg-canvas-soft-2">
    <div class="mx-auto max-w-[1400px] px-6 py-20">
      <h2 class="text-display-md text-ink mb-8 text-center">
        Every framework. One tool.
      </h2>
      <p class="text-body-lg text-body text-center max-w-2xl mx-auto mb-16">
        SVG2Component converts raw SVG code into production-ready components for every major frontend framework. No uploads. No API calls. Everything runs in your browser.
      </p>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Feature cards -->
        <div class="rounded-lg bg-canvas p-6 shadow-level-2">
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-canvas-soft-2 mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m5 12 7-7 7 7"/>
              <path d="M12 19V5"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink mb-1">Zero latency.</h3>
          <p class="text-body-sm text-body">DOMParser runs in your browser. No server round-trips, no loading spinners. Results appear as you type.</p>
        </div>

        <div class="rounded-lg bg-canvas p-6 shadow-level-2">
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-canvas-soft-2 mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink mb-1">Private by design.</h3>
          <p class="text-body-sm text-body">Your SVG never leaves your machine. No tracking, no analytics, no cookies. Open source and verifiable.</p>
        </div>

        <div class="rounded-lg bg-canvas p-6 shadow-level-2">
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-canvas-soft-2 mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink mb-1">Production ready.</h3>
          <p class="text-body-sm text-body">TypeScript interfaces, prop spreading, forwardRef, currentColor — every output is ready to drop into your codebase.</p>
        </div>

        <div class="rounded-lg bg-canvas p-6 shadow-level-2">
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-canvas-soft-2 mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <path d="M8 21h8"/>
              <path d="M12 17v4"/>
            </svg>
          </div>
          <h3 class="text-body-md-strong text-ink mb-1">Every framework.</h3>
          <p class="text-body-sm text-body">React JSX, Vue 3 SFC, Svelte 5, React Native with NativeWind, and Tailwind-optimized variants — all from one tool.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
